
import numpy as np
import matplotlib as plt
from mpl_toolkits.mplot3d import Axes3D
import matplotlib.pyplot as plt



#VARIABLE DECLARE

N = 256 #size numbor keep less than 1000 for now have it usually around 250
x = np.linspace(0, 1, N) #lovely grids
y = np.linspace(0, 1, N) #mmmm yummy grid
X, Y = np.meshgrid(x, y) #love my grids meshed
kx = np.fft.fftfreq(N).reshape(-1,1) #Column reshape
ky = np.fft.fftfreq(N).reshape(1,-1) #Row Reshape
k2 = kx**2 + ky**2



print('k shape', np.shape(k2))
alpha = 4 #smoothening parameter for our Edwards Wilkinson 


beta = 2  #fBM fractional brownian motion beta parameter
# 0 = chaos, 1 = pink, 2 = equilibrium

"""
<<<~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>>    
<<<~~~~~~~~~~~~~FEW NOTES ON FBM~~~~~~~~~~~~~~>>>
<<<~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~>>> 

fBM controls the core relationship in our EW equation derived from the Fourier transform of the Poisson equation 

which is:
    u_hat ~ 1/(k^2)  from  u_hat = f_hat / k^2

we instead get:
    u_hat ~ 1/(k^beta)

this means when beta = 0 then:
    u_hat = f_hat / 1

which increases noise at small scales everywhere.

This can look like smoothing when mean(f) = 0 since we are adding balanced noise repeatedly.

However, increasing the mean can produce chaotic noise.
"""
steps = 1000 #step
mean = 0 # mean for np.random.normal
stdv = 0.2   # standard deviation for noise 
dt = 1 #timestep!

freq = 1.4 #number of sinewaves across noise grid
noise_1 = np.random.normal(loc=mean,scale = stdv, size = (N,N)) #GAUSS NOISE
noise_2= np.sin(2 * np.pi * X * freq) * np.cos(2 * np.pi * Y * freq) 

print(noise_1)
noise_0 = noise_1


f = noise_0
f = f - np.mean(f)        #f = f - mean if mean = 0 

#if np.mean(f) < 2e-10:
#    print("mean is zeroed") #just for peace of mind since its often really close but not quite zero

## FOURIER TRANSFORM TIME

f_hat = np.fft.fft2(f) #Make f hat
                       # |k^2| = kx^2 + ky^2




k2[0,0] = 1 #avoid /0 error, justification in full write up

u_hat = f_hat / k2
u_hat[0,0] = 0
print('uhat at 0,0', u_hat[0,0])
u_init = np.fft.ifft2(u_hat).real



N = u_init.shape[0]


fig = plt.figure(figsize=(8,6))
ax1 = fig.add_subplot(121, projection='3d')

surf = ax1.plot_surface(X, Y, u_init, cmap='terrain', edgecolor='none')



fig.colorbar(surf, shrink=0.5, aspect=5)

ax1.set_title("Original Terrain")
print('set std to this!',u_init.std())
u_hat_loop = u_hat


print('look at me look at me',np.fft.fft2(noise_0)[0,0])


#----------------#
#    MAIN LOOP   #
#----------------#
count = 1
for t in (range(steps)): 
    f_new = noise_1 #noise that will be squewed and distributed over time
    f_hat_new = np.fft.fft2(f_new)/(k2**(beta/2)+1e-10)

    u_hat_loop = ((u_hat_loop * np.exp(-alpha * k2 * dt) + f_hat_new * dt)) #solved duhamel 
    count = count + 1
    u_fin = np.fft.ifft2(u_hat_loop).real
    #print(t,"working")
ax2 = fig.add_subplot(122, projection='3d')
surf = ax2.plot_surface(X, Y, u_fin/steps, cmap='terrain', edgecolor='none')


fig.colorbar(surf, shrink=0.5, aspect=5)
#title = 'Terrain after', steps, 'iterations'
ax2.set_title("Terrain after 300 iterations")

plt.show()
